+++ b/excalidraw-app/components/R2StorageDialog.tsx
@@ -0,0 +1,252 @@
+import {
+  CaptureUpdateAction,
+  useExcalidrawAPI,
+} from "@excalidraw/excalidraw";
+import { Dialog } from "@excalidraw/excalidraw/components/Dialog";
+import { FilledButton } from "@excalidraw/excalidraw/components/FilledButton";
+import { TextField } from "@excalidraw/excalidraw/components/TextField";
+import {
+  ExportIcon,
+  LoadIcon,
+  TrashIcon,
+} from "@excalidraw/excalidraw/components/icons";
+import React, { useCallback, useEffect, useState } from "react";
+
+import { atom, useAtom } from "../app-jotai";
+import {
+  deleteDiagram,
+  isValidDiagramName,
+  listDiagrams,
+  loadDiagram,
+  saveDiagram,
+} from "../data/r2Storage";
+
+import type { R2DiagramMeta } from "../data/r2Storage";
+
+export type R2StorageDialogMode = "save" | "open";
+
+export const r2StorageDialogAtom = atom<{
+  isOpen: boolean;
+  mode: R2StorageDialogMode;
+}>({ isOpen: false, mode: "save" });
+
+const fmtDate = (ts: number) =>
+  new Date(ts).toLocaleString(undefined, {
+    dateStyle: "short",
+    timeStyle: "short",
+  });
+
+const rowStyle: React.CSSProperties = {
+  display: "flex",
+  alignItems: "center",
+  gap: "0.5em",
+  padding: "0.35em 0",
+  borderBottom: "1px solid var(--color-border-outline)",
+};
+
+const R2StorageDialogInner = ({
+  mode,
+  onClose,
+}: {
+  mode: R2StorageDialogMode;
+  onClose: () => void;
+}) => {
+  const excalidrawAPI = useExcalidrawAPI();
+  const [name, setName] = useState("");
+  const [diagrams, setDiagrams] = useState<R2DiagramMeta[]>([]);
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState("");
+  const [notice, setNotice] = useState("");
+
+  const refresh = useCallback(async () => {
+    try {
+      setDiagrams(await listDiagrams());
+    } catch (err: any) {
+      setError(err.message);
+    }
+  }, []);
+
+  useEffect(() => {
+    setError("");
+    refresh();
+  }, [refresh]);
+
+  const handleSave = async () => {
+    const trimmed = name.trim();
+    if (!isValidDiagramName(trimmed)) {
+      setError(
+        "Diagram name must be 1-100 characters: letters, digits, '.', '_', '-'.",
+      );
+      return;
+    }
+    if (!excalidrawAPI) {
+      return;
+    }
+    setBusy(true);
+    setError("");
+    setNotice("");
+    try {
+      await saveDiagram(
+        trimmed,
+        excalidrawAPI.getSceneElements(),
+        excalidrawAPI.getAppState(),
+        excalidrawAPI.getFiles(),
+      );
+      setNotice(`Saved "${trimmed}" to R2.`);
+      setName("");
+      await refresh();
+    } catch (err: any) {
+      setError(err.message);
+    } finally {
+      setBusy(false);
+    }
+  };
+
+  const handleOpen = async (diagram: R2DiagramMeta) => {
+    setBusy(true);
+    setError("");
+    try {
+      const data = await loadDiagram(diagram.name);
+      if (excalidrawAPI) {
+        excalidrawAPI.addFiles(Object.values(data.files));
+        excalidrawAPI.updateScene({
+          elements: data.elements,
+          appState: data.appState,
+          captureUpdate: CaptureUpdateAction.IMMEDIATELY,
+        });
+      }
+      onClose();
+    } catch (err: any) {
+      setError(err.message);
+    } finally {
+      setBusy(false);
+    }
+  };
+
+  const handleDelete = async (diagram: R2DiagramMeta) => {
+    if (!window.confirm(`Delete "${diagram.name}" from R2?`)) {
+      return;
+    }
+    setBusy(true);
+    setError("");
+    setNotice("");
+    try {
+      await deleteDiagram(diagram.name);
+      setNotice(`Deleted "${diagram.name}".`);
+      await refresh();
+    } catch (err: any) {
+      setError(err.message);
+    } finally {
+      setBusy(false);
+    }
+  };
+
+  return (
+    <Dialog
+      onCloseRequest={onClose}
+      title="R2 diagram storage"
+      size={550}
+      closeOnClickOutside={!busy}
+    >
+      <div
+        style={{
+          display: "flex",
+          flexDirection: "column",
+          gap: "0.75em",
+          maxHeight: "70vh",
+          overflowY: "auto",
+        }}
+      >
+        <div style={{ display: "flex", gap: "0.5em", alignItems: "flex-end" }}>
+          <div style={{ flex: 1 }}>
+            <TextField
+              label="Diagram name"
+              placeholder="e.g. architecture-overview"
+              value={name}
+              onChange={setName}
+              onKeyDown={(event) => {
+                if (event.key === "Enter") {
+                  handleSave();
+                }
+              }}
+            />
+          </div>
+          <FilledButton
+            label="Save current scene"
+            icon={ExportIcon}
+            size="large"
+            onClick={handleSave}
+          />
+        </div>
+
+        {notice && <div style={{ color: "var(--color-positive)" }}>{notice}</div>}
+        {error && <div style={{ color: "var(--color-danger)" }}>{error}</div>}
+
+        <div>
+          <div style={{ fontWeight: 600, marginBottom: "0.25em" }}>
+            Saved diagrams ({diagrams.length})
+          </div>
+          {diagrams.length === 0 && (
+            <div style={{ color: "var(--color-text-secondary)" }}>
+              No diagrams saved yet. Name a diagram above and save it to R2.
+            </div>
+          )}
+          {diagrams.map((diagram) => (
+            <div key={diagram.name} style={rowStyle}>
+              <span style={{ flex: 1, overflowWrap: "anywhere" }}>
+                {diagram.name}
+              </span>
+              <span
+                style={{
+                  flexShrink: 0,
+                  color: "var(--color-text-secondary)",
+                  fontSize: "0.85em",
+                }}
+              >
+                {fmtDate(diagram.lastModified)}
+              </span>
+              <FilledButton
+                label={`Open ${diagram.name}`}
+                icon={LoadIcon}
+                size="medium"
+                disabled={busy}
+                onClick={() => handleOpen(diagram)}
+              >
+                Open
+              </FilledButton>
+              <FilledButton
+                label={`Delete ${diagram.name}`}
+                icon={TrashIcon}
+                size="medium"
+                variant="outlined"
+                disabled={busy}
+                onClick={() => handleDelete(diagram)}
+              >
+                Delete
+              </FilledButton>
+            </div>
+          ))}
+        </div>
+
+        <div style={{ color: "var(--color-text-secondary)", fontSize: "0.85em" }}>
+          Diagrams are stored in the Cloudflare R2 bucket
+          <code> architechtus-draw-diagrams</code> behind Cloudflare Access.
+          {mode === "save" ? " Saving embeds images into the diagram." : ""}
+        </div>
+      </div>
+    </Dialog>
+  );
+};
+
+export const R2StorageDialog = () => {
+  const [{ isOpen, mode }, setState] = useAtom(r2StorageDialogAtom);
+  if (!isOpen) {
+    return null;
+  }
+  return (
+    <R2StorageDialogInner
+      mode={mode}
+      onClose={() => setState({ isOpen: false, mode })}
+    />
+  );
+};
