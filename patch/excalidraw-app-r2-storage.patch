new file mode 100644
index 0000000..ec96d3b
--- /dev/null
+++ b/excalidraw-app/data/r2Storage.ts
@@ -0,0 +1,80 @@
+import { MIME_TYPES } from "@excalidraw/common";
+import type { ExcalidrawElement } from "@excalidraw/element/types";
+import { loadFromBlob } from "@excalidraw/excalidraw/data/blob";
+import { serializeAsJSON } from "@excalidraw/excalidraw/data/json";
+import type { RestoredDataState } from "@excalidraw/excalidraw/data/restore";
+import type {
+  AppState,
+  BinaryFiles,
+} from "@excalidraw/excalidraw/types";
+
+export type R2DiagramMeta = {
+  name: string;
+  lastModified: number;
+  size: number;
+};
+
+// Same worker serves both the SPA and this API, so relative URLs are fine and
+// the browser's Cloudflare Access session cookie is sent automatically.
+const API_BASE = "/api/diagrams";
+
+const NAME_PATTERN = /^[a-zA-Z0-9._-]{1,100}$/;
+
+export const isValidDiagramName = (name: string) => NAME_PATTERN.test(name.trim());
+
+const ensureOk = async (response: Response) => {
+  if (response.ok) {
+    return response;
+  }
+  let message = `R2 storage request failed (${response.status})`;
+  try {
+    const data = await response.json();
+    if (data?.error) {
+      message = data.error;
+    }
+  } catch {
+    // keep the default message
+  }
+  throw new Error(message);
+};
+
+export const listDiagrams = async (): Promise<R2DiagramMeta[]> => {
+  const response = await ensureOk(await fetch(`${API_BASE}`));
+  return response.json();
+};
+
+export const saveDiagram = async (
+  name: string,
+  elements: readonly ExcalidrawElement[],
+  appState: Partial<AppState>,
+  files: BinaryFiles,
+): Promise<void> => {
+  // "local" serialization embeds the image files as data URLs, so a single
+  // R2 object holds the whole diagram (no separate file handling needed).
+  const json = serializeAsJSON(elements, appState, files, "local");
+  await ensureOk(
+    await fetch(`${API_BASE}/${encodeURIComponent(name.trim())}`, {
+      method: "PUT",
+      headers: { "Content-Type": MIME_TYPES.excalidraw },
+      body: json,
+    }),
+  );
+};
+
+export const loadDiagram = async (name: string): Promise<RestoredDataState> => {
+  const response = await ensureOk(
+    await fetch(`${API_BASE}/${encodeURIComponent(name)}`),
+  );
+  const blob = new Blob([await response.text()], {
+    type: MIME_TYPES.excalidraw,
+  });
+  return loadFromBlob(blob, null, null);
+};
+
+export const deleteDiagram = async (name: string): Promise<void> => {
+  await ensureOk(
+    await fetch(`${API_BASE}/${encodeURIComponent(name)}`, {
+      method: "DELETE",
+    }),
+  );
+};
